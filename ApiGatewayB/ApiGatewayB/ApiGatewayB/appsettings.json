{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "librosRoute": {
        "ClusterId": "librosCluster",
        "Match": {
          "Path": "/api/Libros/{**catch-all}"
        }
      },
      "inventarioRoute": {
        "ClusterId": "inventariosCluster",
        "Match": {
          "Path": "/api/Inventarios/{**catch-all}"
        }
      },
      "pacientesRoute": {
        "ClusterId": "pacientesCluster",
        "Match": {
          "Path": "/api/Pacientes/{**catch-all}"
        }
      },
      "historialRoute": {
        "ClusterId": "historialCluster",
        "Match": {
          "Path": "/api/HistorialClinicos/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "librosCluster": {
        "Destinations": {
          "libroDestination": {
            "Address": "https://localhost:7157/"
          }
        }
      },
      "inventariosCluster": {
        "Destinations": {
          "inventariosDestination": {
            "Address": "https://localhost:7141/"
          }
        }
      },
      "pacientesCluster": {
        "Destinations": {
          "pacientesDestination": {
            "Address": "https://localhost:7261/"
          }
        }
      },
      "historialCluster": {
        "Destinations": {
          "historialDestination": {
            "Address": "https://localhost:7271/"
          }
        }
      }
    }
  }
}